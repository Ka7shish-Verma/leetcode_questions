class Solution {
public:
    TreeNode* build(vector<int>& inorder, vector<int>& postorder,
                    int& index, int left, int right) {
        
        if (left > right)
            return NULL;

        int value = postorder[index--];
        TreeNode* root = new TreeNode(value);

        int pos = left;
        while (inorder[pos] != value)
            pos++;

        // Build right first because postorder is read from right to left
        root->right = build(inorder, postorder, index, pos + 1, right);
        root->left = build(inorder, postorder, index, left, pos - 1);

        return root;
    }

    TreeNode* buildTree(vector<int>& inorder, vector<int>& postorder) {
        int index = postorder.size() - 1;
        return build(inorder, postorder, index, 0, inorder.size() - 1);
    }
};
