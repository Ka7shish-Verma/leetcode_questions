class Solution {
public:
    bool isValidSudoku(vector<vector<char>>& board) {

        // 9 rows, 9 columns, 9 boxes
        bool row[9][9] = {};
        bool col[9][9] = {};
        bool box[9][9] = {};

        for (int i = 0; i < 9; i++) {
            for (int j = 0; j < 9; j++) {

                // Ignore empty cells
                if (board[i][j] == '.') {
                    continue;
                }

                // Convert '1'-'9' to index 0-8
                int num = board[i][j] - '1';

                // Find the 3x3 box
                int boxIndex = (i / 3) * 3 + (j / 3);

                // Check duplicate
                if (row[i][num] ||
                    col[j][num] ||
                    box[boxIndex][num]) {
                    return false;
                }

                // Mark the number as used
                row[i][num] = true;
                col[j][num] = true;
                box[boxIndex][num] = true;
            }
        }

        return true;
    }
};
