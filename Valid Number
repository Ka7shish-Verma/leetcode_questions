class Solution {
public:
    bool isNumber(string s) {
        bool digitSeen = false;
        bool dotSeen = false;
        bool exponentSeen = false;
        bool exponentDigit = true;

        for (int i = 0; i < s.length(); i++) {
            char c = s[i];

            // Digit
            if (isdigit(c)) {
                digitSeen = true;

                // If we are after e/E, exponent must contain a digit
                if (exponentSeen)
                    exponentDigit = true;
            }

            // Decimal point
            else if (c == '.') {
                // Dot is not allowed after e/E or more than once
                if (dotSeen || exponentSeen)
                    return false;

                dotSeen = true;
            }

            // Exponent
            else if (c == 'e' || c == 'E') {
                // e/E can occur only once and must have a number before it
                if (exponentSeen || !digitSeen)
                    return false;

                exponentSeen = true;
                exponentDigit = false;
            }

            // Sign
            else if (c == '+' || c == '-') {
                // Sign is valid only at the beginning or immediately after e/E
                if (i != 0 && s[i - 1] != 'e' && s[i - 1] != 'E')
                    return false;
            }

            // Any other character is invalid
            else {
                return false;
            }
        }

        // Number must contain digits
        // Exponent, if present, must also contain digits
        return digitSeen && exponentDigit;
    }
};
