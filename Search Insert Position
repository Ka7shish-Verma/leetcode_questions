class Solution {
public:
    int searchInsert(vector<int>& nums, int target) {
        int left = 0;
        int right = nums.size() - 1;

        while (left <= right) {
            int mid = left + (right - left) / 2;

            // Target found
            if (nums[mid] == target) {
                return mid;
            }

            // Target is greater
            if (nums[mid] < target) {
                left = mid + 1;
            }
            // Target is smaller
            else {
                right = mid - 1;
            }
        }

        // left is the correct insertion position
        return left;
    }
};
