class Solution {
public:
    int longestValidParentheses(string s) {
        stack<int> st;

        // Base index before the start of a valid substring
        st.push(-1);

        int maxLength = 0;

        for (int i = 0; i < s.length(); i++) {

            if (s[i] == '(') {
                // Store index of opening bracket
                st.push(i);
            }
            else {
                // Remove the matching opening bracket
                st.pop();

                if (st.empty()) {
                    // No matching opening bracket
                    // Start a new possible substring
                    st.push(i);
                }
                else {
                    // Length of current valid substring
                    int length = i - st.top();

                    maxLength = max(maxLength, length);
                }
            }
        }

        return maxLength;
    }
};
