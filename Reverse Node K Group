class Solution {
public:
    ListNode* reverseKGroup(ListNode* head, int k) {
        
        // Check whether there are at least k nodes
        ListNode* temp = head;

        for (int i = 0; i < k; i++) {
            if (temp == nullptr)
                return head;   // Less than k nodes, don't reverse
            temp = temp->next;
        }

        // Reverse k nodes
        ListNode* prev = nullptr;
        ListNode* curr = head;

        for (int i = 0; i < k; i++) {
            ListNode* nextNode = curr->next;
            curr->next = prev;
            prev = curr;
            curr = nextNode;
        }

        // head is now the last node of the reversed group
        head->next = reverseKGroup(curr, k);

        // prev is the new head of this group
        return prev;
    }
};
